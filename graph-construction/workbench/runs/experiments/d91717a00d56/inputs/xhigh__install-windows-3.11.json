68:    for (y = 0; y < height; y += VNC_STAT_RECT) {\n69:        for (x = 0; x < width; x += VNC_STAT_RECT) {\n70:            VncRectStat *rect = vnc_stat_rect(vd, x, y);\n71:\n72:            rect->updated = false;\n73:        }\n74:    }\n75:\n76:    qemu_timersub(tv, &VNC_REFRESH_STATS, &res);\n77:\n78:    if (timercmp(&vd->guest.last_freq_check, &res, >)) {\n79:        return has_dirty;\n80:    }\n81:    vd->guest.last_freq_check = *tv;\n82:\n83:    for (y = 0; y < height; y += VNC_STAT_RECT) {\n84:        for (x = 0; x < width; x += VNC_STAT_RECT) {\n85:            VncRectStat *rect= vnc_stat_rect(vd, x, y);\n86:            int count = ARRAY_SIZE(rect->times);\n87:            struct timeval min, max;\n88:\n89:            if (!timerisset(&rect->times[count - 1])) {\n90:                continue ;\n\n\nWall time: 0.02 seconds",

            "content": "#!/bin/bash\n# Start Windows 3.11 for Workgroups in QEMU.\n#\n# Configuration:\n#  - QEMU 5.2.0 (built from source): this disk image is known to be\n#    compatible with QEMU 5.2.0; the apt QEMU 8.2.2 fails on it\n#    (CHS/geometry mismatch in the disk boot sector).\n#  - -vga cirrus         : Cirrus Logic GD 5446. The image's PROTOCOL.INI\n#                          configures Svga256.drv for a \"CirrusLogic\n#                          5436/46\" chipset, so a Cirrus VGA is required for\n#                          the SVGA (1024x768) display to work. With a plain\n#                          standard VGA (-vga std) the SVGA driver falls back\n#                          to CGA / a black screen.\n#  - -snapshot              : keeps the base disk image (/app/isos/win311.img)\n#                             immutable; all guest writes go to a temporary\n#                             qcow2 overlay (base image is never modified).\n#  - -vnc :1                : VNC display :1, i.e. listening on port 5901.\n#  - -monitor unix:...      : QEMU (HMP) monitor socket at\n#                             /tmp/qemu-monitor.sock for programmatic keyboard\n#                             input (sendkey) and other control beyond plain\n#                             VNC interaction.\n#  - -qmp unix:...          : QMP socket used by local automation tooling.\n#  - -serial file:...       : boot diagnostics on the serial port.\n#  - -netdev/-net nic       : a PCI \"Realtek RTL8029\" Ethernet card. The\n#                             Windows 3.1 Workgroups network stack on this\n#                             disk (PCIND/NDIS driver) scans the PCI bus for a\n#                             Realtek 8029 (vendor 0x10ec, device 0x8029) at\n#                             boot; without one it stalls on a\n#                             \"No RTL8029 adapter exists on your system\"\n#                             warning. QEMU's ne2k_pci device identifies\n#                             itself as 10ec:8029, so the driver finds it\n#                             and Windows boots through to the desktop.\n#\n# Run in the background (detached, logging to /app/qemu.log):\n#   setsid nohup /app/start-vm.sh > /app/qemu.log 2>&1 &\n\nset -e\n\nQEMU=/tmp/qemu-5.2.0/build/qemu-system-i386\nIMG=/app/isos/win311.img\nMON=/tmp/qemu-monitor.sock\nQMP=/tmp/qemu-qmp.sock\n\nrm -f \"$MON\" \"$QMP\" /app/serial.log\n\nexec \"$QEMU\" \\\n  -machine pc \\\n  -m 32 \\\n  -vga cirrus \\\n  -drive file=\"$IMG\",if=ide,media=disk \\\n  -snapshot \\\n  -netdev user,id=n0 \\\n  -net nic,netdev=n0,model=ne2k_pci \\\n  -vnc :1 \\\n  -monitor unix:\"$MON\",server,nowait \\\n  -qmp unix:\"$QMP\",server,nowait \\\n  -serial file:/app/serial.log \\\n  -gdb tcp:127.0.0.1:12345\n",

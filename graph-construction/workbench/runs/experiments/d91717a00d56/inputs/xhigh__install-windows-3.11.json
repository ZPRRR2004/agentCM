            "content": "#!/usr/bin/env python3\n\"\"\"Robust QMP client for QEMU 5.2 (single unix socket, retries, keep-alive).\n\nUsage:\n  python3 qmp.py status\n  python3 qmp.py screendump /tmp/x.ppm\n  python3 qmp.py sendkey ret\n  python3 qmp.py sendkey a b c\n  python3 qmp.py stop | cont\n  python3 qmp.py system_reset\n  python3 qmp.py blockinfo\n  python3 qmp.py mouse x y button state     (button: left|right|middle; state: down|up)\n  python3 qmp.py mouseclick x y\n  python3 qmp.py raw '{\"execute\":...}'\nEach invocation opens its own connection (safe for one-shot commands).\n\"\"\"\nimport socket, json, sys, time\n\nSOCK = '/tmp/qemu-qmp.sock'\n\nclass QMP:\n    def __init__(self, path=SOCK, tries=5, delay=2.0):\n        self.s = None\n        for i in range(tries):\n            try:\n                s = socket.socket(socket.AF_UNIX)\n                s.settimeout(10)\n                s.connect(path)\n                # read greeting\n                data = s.recv(65536)\n                json.JSONDecoder().raw_decode(data.decode('utf-8', 'replace'))\n                self.s = s\n                break\n            except Exception as e:\n                if i == tries - 1:\n                    raise\n                time.sleep(delay)\n        if self.s is None:\n            raise RuntimeError('cannot connect to QMP')\n        self.buf = ''\n        self.cmd('qmp_capabilities')\n\n    def _readmsg(self, timeout=15):\n        self.s.settimeout(timeout)\n        while True:\n            if self.buf:\n                try:\n                    o, e = json.JSONDecoder().raw_decode(self.buf)\n                    self.buf = self.buf[e:]\n                    return o\n                except json.JSONDecodeError:\n                    pass\n            try:\n                self.buf += self.s.recv(65536).decode('utf-8', 'replace')\n            except socket.timeout:\n                raise\n\n    def cmd(self, name, args=None, timeout=20, tries=3):\n        last = None\n        for i in range(tries):\n            try:\n                self.s.settimeout(timeout)\n                self.s.sendall((json.dumps({'execute': name, 'arguments': args or {}}) + '\\n').encode())\n                while True:\n                    o = self._readmsg(timeout)\n                    if 'return' in o:\n                        return o['return']\n                    if 'error' in o:\n                        return {'error': o['error']}\n                return None\n            except socket.timeout:\n                last = 'timeout'\n                time.sleep(1)\n        raise RuntimeError(f'QMP {name} failed: {last}')\n\n    def close(self):\n        try:\n            self.s.close()\n        except Exception:\n            pass\n\n\ndef main():\n    if len(sys.argv) < 2:\n        print(__doc__); sys.exit(1)\n    cmd = sys.argv[1]\n    q = QMP()\n    try:\n        if cmd == 'status':\n            print(json.dumps(q.cmd('query-status')))\n        elif cmd == 'screendump':\n            q.cmd('screendump', {'filename': sys.argv[2]})\n            print('ok ' + sys.argv[2])\n        elif cmd == 'sendkey':\n            for k in sys.argv[2:]:\n                q.cmd('send-key', {'keys': [k]})\n                time.sleep(0.3)\n            print('sent', ' '.join(sys.argv[2:]))\n        elif cmd == 'stop':\n            print(q.cmd('stop'))\n        elif cmd == 'cont':\n            print(q.cmd('cont'))\n        elif cmd == 'system_reset':\n            print(q.cmd('system_reset'))\n        elif cmd == 'blockinfo':\n            print(json.dumps(q.cmd('query-block'), indent=1))\n        elif cmd == 'mouse':\n            x, y, button, state = int(sys.argv[2]), int(sys.argv[3]), sys.argv[4], sys.argv[5]\n            print(q.cmd('mouse_event', {'x': x, 'y': y, 'button': button, 'down': state == 'down'}))\n        elif cmd == 'mouseclick':\n            x, y = int(sys.argv[2]), int(sys.argv[3])\n            q.cmd('mouse_event', {'x': x, 'y': y, 'button': 'left', 'down': True})\n            time.sleep(0.1)\n            q.cmd('mouse_event', {'x': x, 'y': y, 'button': 'left', 'down': False})\n            print('clicked', x, y)\n        elif cmd == 'raw':\n            o = json.loads(sys.argv[2])\n            print(json.dumps(q.cmd(o['execute'], o.get('arguments'))))\n        else:\n            print('unknown', cmd); sys.exit(1)\n    finally:\n        q.close()\n\nmain()\n",

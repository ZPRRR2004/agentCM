            "content": "#!/usr/bin/env python3\n\"\"\"Minimal QMP client for /tmp/qemu-qmp.sock.\n\nUsage:\n  qmp.py <command> [json-args]\n  e.g. qmp.py query-block '{}'\n       qmp.py screendump '{\"filename\": \"/tmp/screen.ppm\"}'\n       qmp.py sendkey '{\"keys\": [\"enter\"]}'\n\"\"\"\nimport json\nimport socket\nimport sys\nimport time\n\n\nclass QMP:\n    def __init__(self, path=\"/tmp/qemu-qmp.sock\", timeout=15):\n        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n        self.s.connect(path)\n        self.s.settimeout(timeout)\n        self.buf = b\"\"\n        # Greeting\n        self._read_line()\n        self._execute(\"qmp_capabilities\", None)\n\n    def _read_line(self):\n        while b\"\\n\" not in self.buf:\n            d = self.s.recv(65536)\n            if not d:\n                raise EOFError(\"QMP connection closed\")\n            self.buf += d\n        line, self.buf = self.buf.split(b\"\\n\", 1)\n        return json.loads(line)\n\n    def _execute(self, name, args, timeout=None):\n        if timeout:\n            self.s.settimeout(timeout)\n        self.s.sendall((json.dumps({\"execute\": name} | ({\"arguments\": args} if args else {})) + \"\\n\").encode())\n        while True:\n            try:\n                msg = self._read_line()\n            except socket.timeout:\n                return {\"error\": \"timeout\"}\n            if \"return\" in msg or \"error\" in msg:\n                return msg\n            # Ignore events\n\n    def execute(self, name, args=None, timeout=15):\n        return self._execute(name, args, timeout)\n\n    def close(self):\n        try:\n            self.s.close()\n        except OSError:\n            pass\n\n\nif __name__ == \"__main__\":\n    name = sys.argv[1]\n    args = json.loads(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2] not in (\"\", \"{}\") else (json.loads(sys.argv[2]) if len(sys.argv) > 2 else None)\n    q = QMP()\n    try:\n        res = q.execute(name, args)\n    final
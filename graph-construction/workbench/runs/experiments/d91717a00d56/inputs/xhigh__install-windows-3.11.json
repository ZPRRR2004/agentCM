Error\n            self.buf += d\n        line, self.buf = self.buf.split(b\"\\n\", 1)\n        return json.loads(line)\n    def send(self, obj):\n        self.s.sendall((json.dumps(obj) + \"\\n\").encode())\n    def execute(self, name, args=None, timeout=15):\n        self.s.settimeout(timeout)\n        self.send({\"execute\": name, **({\"arguments\": args} if args else {})})\n        while True:\n            try:\n                msg = self._read_line()\n            except socket.timeout:\n                break\n            if \"return\" in msg or \"error\" in msg:\n                return msg\n            # event, ignore\n    def close(self):\n        self.s.close()\n```\n\nCaveat: each new connection requires qmp_capabilities. For one-off commands, open a connection per command.\n\nWait a moment — same concern as with HMP: does an early disconnect break the QMP command? For QMP, `screendump` gets executed when the main loop processes the command. If we close right after receiving the response, the command has already completed (the response comes after execution). QMP is request/response — the response is only sent after execution. So for QMP there's no early-disconnect problem (unlike HMP, where the prompt arrives before processing).\n\nAlright, let's write qmp.py and use it to query the block device and take a screendump.\n\n\n\nLog is empty and screen still black. Let me build a QMP helper to inspect block devices and take controlled screenshots.\n\n",
